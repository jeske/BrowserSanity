<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  
  <PropertyGroup Label="Globals">
    <!-- ProjectGuid generated using: powershell -Command "[System.Guid]::NewGuid()" -->
    <ProjectGuid>{7bd6cb96-7a65-48a1-8108-25a6e737c3c5}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  
  <PropertyGroup>
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v142</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <OutDir>build-Release\</OutDir>
    <IntDir>build\BrowserSanity\</IntDir>
    <TargetName>BrowserSanity</TargetName>
  </PropertyGroup>
  
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  
  <PropertyGroup>
    <IncludePath>include;$(IncludePath)</IncludePath>
  </PropertyGroup>
  
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;WIN32;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>advapi32.lib;comctl32.lib;ole32.lib;shell32.lib;uuid.lib;wininet.lib;shlwapi.lib;user32.lib;gdi32.lib;comdlg32.lib</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <AdditionalIncludeDirectories>include;res</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  
  <!-- BrowserSanity.exe source files -->
  <ItemGroup>
    <ClCompile Include="src\browser-sanity\main.c" />
    <ClCompile Include="src\browser-sanity\browser_sanity.c" />
    <ClCompile Include="src\browser-sanity\actions\action_resources.c" />
    <ClCompile Include="src\browser-sanity\ui\ui.c" />
    <ClCompile Include="src\browser-sanity\ui\dialog_manualLaunch.c" />
    <ClCompile Include="src\browser-sanity\ui\dialog_mainSettings.c" />
    <ClCompile Include="src\browser-sanity\watchdog\watchdog.c" />
    <ClCompile Include="src\browser-sanity\actions\action_install.c" />
    <ClCompile Include="src\browser-sanity\actions\action_uninstall.c" />
    <ClCompile Include="src\browser-sanity\actions\action_watchdog.c" />
    <ClCompile Include="src\browser-sanity\msedge_redirect_lib.c" />
  </ItemGroup>
  
  <ItemGroup>
    <ResourceCompile Include="res\msedge_binary.rc" />
  </ItemGroup>
  
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  
  <!-- Custom target to build msedge.exe first -->
  <Target Name="BuildMsEdgeRedirect" BeforeTargets="ClCompile">
    <Message Text="Building msedge.exe..." Importance="high" />
    
    <!-- Create intermediate directory for msedge build -->
    <MakeDir Directories="build\MsEdgeRedirect\" />
    
    <!-- Compile msedge-redirect.c -->
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Hostx86\x86\cl.exe&quot; /c /Zi /nologo /W3 /WX- /diagnostics:column /O2 /Oy- /D WIN32 /D _WINDOWS /D _CRT_SECURE_NO_WARNINGS /Gm- /EHsc /MD /GS /fp:precise /Zc:wchar_t /Zc:forScope /Zc:inline /Fo&quot;build\MsEdgeRedirect\\&quot; /Fd&quot;build\MsEdgeRedirect\vc142.pdb&quot; /external:W3 /Gd /TC /analyze- /FC /errorReport:queue /I include &quot;src\msedge-redirect\msedge-redirect.c&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    
    <!-- Link msedge.exe -->
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Hostx86\x86\link.exe&quot; /ERRORREPORT:QUEUE /OUT:&quot;$(OutDir)msedge.exe&quot; /INCREMENTAL:NO /NOLOGO advapi32.lib comctl32.lib ole32.lib shell32.lib uuid.lib wininet.lib shlwapi.lib kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib /MANIFEST /MANIFESTUAC:&quot;level='asInvoker' uiAccess='false'&quot; /manifest:embed /DEBUG /PDB:&quot;$(OutDir)msedge.pdb&quot; /SUBSYSTEM:WINDOWS /TLBID:1 /DYNAMICBASE /NXCOMPAT /IMPLIB:&quot;$(OutDir)msedge.lib&quot; /MACHINE:X86 &quot;build\MsEdgeRedirect\msedge-redirect.obj&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    
    <!-- Copy msedge.exe for resource embedding -->
    <Copy SourceFiles="$(OutDir)msedge.exe" DestinationFiles="build\msedge.exe" />
    
    <Message Text="msedge.exe built successfully" Importance="high" />
  </Target>
  
</Project>